{
	email {$ACME_EMAIL}
	# Admin API is reachable only by the host agent (published on 127.0.0.1 in docker-compose.yml) to reload site routes.
	admin 0.0.0.0:2019 {
		origins 127.0.0.1:2019
	}
	# Certificates for autoconfig.<domain> / autodiscover.<domain> are issued on demand,
	# but only for domains that exist in the database.
	on_demand_tls {
		ask http://web:3000/api/internal/tls-ask
	}
}

# Admin panel, webmail and the mail server hostname (its certificate is also used by Postfix/Dovecot).
{$MAIL_HOSTNAME} {
	encode gzip
	reverse_proxy web:3000
}

# Client auto-configuration hosts for every hosted domain (Thunderbird, Outlook, ...).
https:// {
	tls {
		on_demand
	}
	reverse_proxy web:3000
}

# One generated file per hosted site (written by the host agent, see agent/sites.mjs).
import /etc/caddy/sites/*.caddy

# The company's own marketing site (marketing/caddy/*.caddy), served from marketing/public.
import /etc/caddy/marketing/*.caddy
