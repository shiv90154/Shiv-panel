# Hostname of the mail server (A record must point to this VPS). Used for MX, TLS, webmail and admin UI.
MAIL_HOSTNAME=mail.example.com
SERVER_IPV4=203.0.113.10
SERVER_IPV6=
# "ipv4" or "all" (use "all" only if your VPS has working IPv6 and PTR/SPF cover it)
POSTFIX_INET_PROTOCOLS=ipv4
ACME_EMAIL=you@example.com

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
MAIL_DB_PASSWORD=change-me-too
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-32-bytes-hex

# First admin account (created on first start when no admin exists; sign in at /login with username "admin" or this email)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-long-password

# Optional: lets the admin UI create/update DNS records automatically for domains hosted on Cloudflare.
# Token needs Zone:DNS:Edit and Zone:Zone:Read.
CLOUDFLARE_API_TOKEN=

# Host agent (privileged operations; needed from the sites/databases/files phases on). Run it on the host: see agent/.
# Generate the secret with: openssl rand -hex 32   (agent listens on the docker bridge IP, e.g. AGENT_LISTEN=172.17.0.1:7701)
AGENT_URL=
AGENT_SECRET=
# Sites (Phase 1). Agent-side settings live in /etc/mailhost/agent.env: SITES_ROOT=/srv/accounts, CADDY_SITES_DIR=/srv/caddy-sites
# (same dir mounted into caddy), CADDYFILE_PATH=<repo>/Caddyfile, CADDY_ADMIN=http://127.0.0.1:2019, DOCKER_NETWORK=mailhost_default
CADDY_SITES_DIR=/srv/caddy-sites

# Tenant databases (Phase 2). Host MariaDB/PostgreSQL servers; shown to users as the connection host. Agent-side: MARIADB_CMD, PSQL_CMD, PGHOST/PGUSER/PGPASSWORD in /etc/mailhost/agent.env
MARIADB_HOST=
POSTGRES_TENANT_HOST=

# DNS (Phase 3). PowerDNS runs on the host; agent-side env in /etc/mailhost/agent.env: PDNS_API_KEY, PDNS_API_URL (default http://127.0.0.1:8081), PDNS_NS=ns1.example.com,ns2.example.com
# Panel: SERVER_IPV4 (above) feeds the starter A record of new zones.

# Security & ops (Phase 6). Agent-side env in /etc/mailhost/agent.env (all optional):
#   FIREWALL_SSH_PORT=22 (always kept open), FIREWALL_STATE=/etc/mailhost/firewall.nft, CLAMSCAN_CMD=clamscan, FAIL2BAN_CMD=fail2ban-client
#   Self-update: UPDATE_DIR=/opt/mailhost (the git checkout this stack runs from), UPDATE_REMOTE=origin, UPDATE_BRANCH=main, UPDATE_DUMP_DIR=/var/backups/mailhost
# Per-site WAF needs a Caddy with the Coraza module: docker build -t mailhost-caddy-waf ./caddy, then CADDY_IMAGE=mailhost-caddy-waf
CADDY_IMAGE=
